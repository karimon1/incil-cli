# Kısaltma / takma ad tam eşleşmesi, yoksa kitap adının başıyla eşleşme
function kitap_coz(s,   k, i) {
  k = anahtar(s)
  if (k == "") return 0
  if (k in TAKMA) return TAKMA[k]
  for (i = 1; i <= KITAP_SAY; i++) if (index(TAM[i], k) == 1) return i
  return 0
}

function hata(m) { printf "%s\n", m > "/dev/stderr"; HATA = 1 }

# Aralık ekle: ref r, kitap b, başlangıç/bitiş (bölüm*1000+ayet)
function aralik(r, b, alt, ust) {
  AR_SAY[r]++
  AR_B[r, AR_SAY[r]] = b; AR_ALT[r, AR_SAY[r]] = alt; AR_UST[r, AR_SAY[r]] = ust
}

function ref_coz(r, metin,   kitap_k, sayi, b, parca, n, i, p, a, bas, s2, son, bolum) {
  REF[r] = metin
  if (index(metin, "/")) {
    kitap_k = kirp(substr(metin, 1, index(metin, "/") - 1))
    ARA[r] = katla(kirp(substr(metin, index(metin, "/") + 1)))
    if (ARA[r] == "") { hata("Boş arama: " metin); return }
    if (kitap_k == "") { ARA_B[r] = 0; return }
    if (!(ARA_B[r] = kitap_coz(kitap_k))) hata("Tanınmayan kitap: \"" kitap_k "\"  (liste için: incil -l)")
    return
  }

  if (!match(metin, /^[1-3]?[ .]*[^0-9 :.,;-][^0-9:]*/)) { hata("Anlaşılamayan referans: " metin); return }
  kitap_k = substr(metin, 1, RLENGTH)
  sayi = substr(metin, RLENGTH + 1); gsub(/[ \t]/, "", sayi)
  if (!(b = kitap_coz(kitap_k))) { hata("Tanınmayan kitap: \"" kirp(kitap_k) "\"  (liste için: incil -l)"); return }

  if (sayi == "") { aralik(r, b, 0, 999999); return }

  n = split(sayi, parca, ",")
  bolum = 0
  for (i = 1; i <= n; i++) {
    p = parca[i]
    if (p ~ /^[0-9]+$/) {
      if (bolum) aralik(r, b, bolum * 1000 + p, bolum * 1000 + p)
      else       aralik(r, b, p * 1000, p * 1000 + 999)
    } else if (p ~ /^[0-9]+-[0-9]+$/) {
      split(p, a, "-")
      if (bolum) aralik(r, b, bolum * 1000 + a[1], bolum * 1000 + a[2])
      else       aralik(r, b, a[1] * 1000, a[2] * 1000 + 999)
    } else if (p ~ /^[0-9]+:[0-9]+(-[0-9]+(:[0-9]+)?)?$/) {
      split(p, a, "-")
      split(a[1], bas, ":"); bolum = bas[1] + 0
      if (a[2] == "")             son = bolum * 1000 + bas[2]
      else if (index(a[2], ":")) { split(a[2], s2, ":"); son = s2[1] * 1000 + s2[2] }
      else                        son = bolum * 1000 + a[2]
      aralik(r, b, bolum * 1000 + bas[2], son)
    } else if (p ~ /^[0-9]+:$/) {
      bolum = p + 0
      aralik(r, b, bolum * 1000, bolum * 1000 + 999)
    } else {
      hata("Anlaşılamayan ayet belirtimi: \"" p "\" (" metin ")"); return
    }
  }
}

function sakla(r) {
  n = ++BUL[r]
  S_B[r, n] = $3; S_C[r, n] = $4; S_V[r, n] = $5; S_T[r, n] = $6
}

# Metni genişliğe göre sar; ilk satır önüne `bas`, sonrakilere `girinti`
function sar(metin, gen, bas, girinti,   n, k, i, satir, su, ku) {
  n = split(metin, k, " ")
  satir = ""; su = 0
  for (i = 1; i <= n; i++) {
    ku = uzunluk(k[i])
    if (su && su + 1 + ku > gen) { print bas satir; bas = girinti; satir = k[i]; su = ku }
    else if (su) { satir = satir " " k[i]; su += 1 + ku }
    else { satir = k[i]; su = ku }
  }
  print bas satir
}

function boya(kod, s) { return RENK ? "\033[" kod "m" s "\033[0m" : s }

function liste(   grup, i) {
  grup[1] = "Tevrat"; grup[6] = "Tarih Kitapları"; grup[18] = "Şiir ve Bilgelik"
  grup[23] = "Peygamberler"; grup[40] = "Müjdeler"; grup[44] = "Elçilerin İşleri"
  grup[45] = "Pavlus\047un Mektupları"; grup[58] = "Genel Mektuplar"; grup[66] = "Vahiy"
  print ""
  print "  " boya("1;37", "ESKİ ANTLAŞMA")
  for (i = 1; i <= KITAP_SAY; i++) {
    if (i == 40) { print ""; print "  " boya("1;37", "YENİ ANTLAŞMA") }
    if (i in grup) { print ""; print "  " boya("1;33", grup[i]) }
    printf "    %s%s %s\n", boya("0;36", KISA[i]), substr("      ", 1, 6 - uzunluk(KISA[i])), AD[i]
  }
  print ""
}

