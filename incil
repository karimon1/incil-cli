function katla(s) {
  s = tolower(s)
  gsub(/İ|ı|Î|î/, "i", s); gsub(/Ç|ç/, "c", s); gsub(/Ş|ş/, "s", s)
  gsub(/Ğ|ğ/, "g", s);     gsub(/Ü|ü|Û|û/, "u", s); gsub(/Ö|ö/, "o", s)
  gsub(/Â|â/, "a", s)
  return s
}
function anahtar(s) { s = katla(s); gsub(/[^a-z0-9]/, "", s); return s }
function kirp(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function uzunluk(s,   t) { t = s; return length(s) - gsub(/[\200-\277]/, "", t) }

