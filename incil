#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  incil — Türkçe Yeni Ahit ayet görüntüleyici
#
#  KULLANIM:
#    incil              → rastgele ayet (tüm Yeni Ahit)
#    incil -r           → rastgele ayet
#    incil mat 3:16     → Matta 3:16
#    incil yuh 1        → Yuhanna 1. bölümün tamamı
#    incil -l           → kitap listesi
#    incil -h           → yardım
# ─────────────────────────────────────────────────────────────────────────────

DATA_DIR="$HOME/.local/share/incil"
DATA_FILE="$DATA_DIR/turkish.xml"
DATA_URL="https://raw.githubusercontent.com/christos-c/bible-corpus/master/bibles/Turkish.xml"

# ── Veri yoksa indir ──────────────────────────────────────────────────────────
if [[ ! -f "$DATA_FILE" ]]; then
  printf '\033[1;33mİncil verisi indiriliyor (bir kez)...\033[0m\n'
  mkdir -p "$DATA_DIR"
  if command -v curl &>/dev/null; then
    curl -fsSL "$DATA_URL" -o "$DATA_FILE"
  elif command -v wget &>/dev/null; then
    wget -qO "$DATA_FILE" "$DATA_URL"
  else
    printf '\033[1;31mHata: curl veya wget bulunamadı.\033[0m\n' >&2; exit 1
  fi
  if [[ ! -s "$DATA_FILE" ]]; then
    printf '\033[1;31mHata: Dosya indirilemedi.\033[0m\n' >&2
    rm -f "$DATA_FILE"; exit 1
  fi
  printf '\033[1;32mVeri kaydedildi: %s\033[0m\n' "$DATA_FILE"
fi

# ── Yeni Ahit XML kodları (grep pattern için) ─────────────────────────────────
YA_PATTERN='b\.(MAT|MAR|LUK|JOH|ACT|ROM|COL|EPH|GAL|PHI|PHM|HEB|JAM|JUD|REV|TIT)\.'

# ── Türkçe kısaltma → XML kodu ────────────────────────────────────────────────
kitap_kodu() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    # Dört Müjde
    mat|matta)                printf 'MAT' ;;
    mar|mrk|markos)           printf 'MAR' ;;
    luk|luka)                 printf 'LUK' ;;
    yuh|yuhanna)              printf 'JOH' ;;
    # Elçilerin İşleri
    isi|act|elciler)          printf 'ACT' ;;
    # Pavlus Mektupları
    rom|romalılar|romaliwlar) printf 'ROM' ;;
    gal|galatlar)             printf 'GAL' ;;
    efe|efesliler)            printf 'EPH' ;;
    phi|flp|filipililer)      printf 'PHI' ;;
    kol|koloseliler)          printf 'COL' ;;
    tit|titus)                printf 'TIT' ;;
    flm|phm|filimona)         printf 'PHM' ;;
    # Genel Mektuplar
    ibr|heb|ibraniler)        printf 'HEB' ;;
    yak|jam|yakup)            printf 'JAM' ;;
    yah|jud|yahuda)           printf 'JUD' ;;
    # Vahiy
    vah|rev|vahiy)            printf 'REV' ;;
    *)                        printf ''    ;;
  esac
}

# ── XML kodu → Türkçe ad ──────────────────────────────────────────────────────
kitap_adi() {
  case "$1" in
    MAT) printf 'Matta'             ;;
    MAR) printf 'Markos'            ;;
    LUK) printf 'Luka'              ;;
    JOH) printf 'Yuhanna'           ;;
    ACT) printf 'Elçilerin İşleri'  ;;
    ROM) printf 'Romalılar'         ;;
    GAL) printf 'Galatlar'          ;;
    EPH) printf 'Efesliler'         ;;
    PHI) printf 'Filipililer'       ;;
    COL) printf 'Koloseliler'       ;;
    TIT) printf 'Titus'             ;;
    PHM) printf 'Filimona'          ;;
    HEB) printf 'İbraniler'         ;;
    JAM) printf 'Yakup'             ;;
    JUD) printf 'Yahuda'            ;;
    REV) printf 'Vahiy'             ;;
  esac
}

# ── Kitap listesi ─────────────────────────────────────────────────────────────
liste() {
  printf '\n'
  printf '  \033[1;37mYENİ AHİT KİTAPLARI\033[0m\n'
  printf '  \033[1;30m──────────────────────────────────────────────────\033[0m\n\n'
  printf '  \033[1;33mMüjdeler\033[0m\n'
  printf '    mat   → Matta\n'
  printf '    mar   → Markos\n'
  printf '    luk   → Luka\n'
  printf '    yuh   → Yuhanna\n\n'
  printf '  \033[1;33mElçilerin İşleri\033[0m\n'
  printf '    isi   → Elçilerin İşleri\n\n'
  printf '  \033[1;33mPavlus Mektupları\033[0m\n'
  printf '    rom   → Romalılar\n'
  printf '    gal   → Galatlar\n'
  printf '    efe   → Efesliler\n'
  printf '    phi   → Filipililer\n'
  printf '    kol   → Koloseliler\n'
  printf '    tit   → Titus\n'
  printf '    flm   → Filimona\n\n'
  printf '  \033[1;33mGenel Mektuplar\033[0m\n'
  printf '    ibr   → İbraniler\n'
  printf '    yak   → Yakup\n'
  printf '    yah   → Yahuda\n\n'
  printf '  \033[1;33mVahiy\033[0m\n'
  printf '    vah   → Vahiy\n'
  printf '\n'
}

# ── Yardım ────────────────────────────────────────────────────────────────────
yardim() {
  printf '\n'
  printf '  \033[1;37mKULLANIM\033[0m\n'
  printf '    incil              → rastgele ayet (tüm Yeni Ahit)\n'
  printf '    incil -r           → rastgele ayet\n'
  printf '    incil mat 3:16     → Matta 3:16\n'
  printf '    incil yuh 1        → Yuhanna 1. bölümün tamamı\n'
  printf '    incil -l           → tüm kitap listesi ve kısaltmalar\n'
  printf '    incil -h           → bu yardım\n'
  printf '\n'
}

# ── Ayeti ekrana bas ──────────────────────────────────────────────────────────
ayeti_goster() {
  local id_satir="$1"
  local satir_no seg_id kod bolum ayet_no metin

  satir_no=$(printf '%s' "$id_satir" | cut -d: -f1)
  seg_id=$(printf '%s' "$id_satir" \
    | grep -oE 'b\.(MAT|MAR|LUK|JOH|ACT|ROM|COL|EPH|GAL|PHI|PHM|HEB|JAM|JUD|REV|TIT)\.[0-9]+\.[0-9]+')

  metin=$(sed -n "$((satir_no + 1))p" "$DATA_FILE" \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  kod=$(    printf '%s' "$seg_id" | cut -d. -f2)
  bolum=$(  printf '%s' "$seg_id" | cut -d. -f3)
  ayet_no=$(printf '%s' "$seg_id" | cut -d. -f4)

  printf '  \033[0;36m"%s"\033[0m\n' "$metin"
  printf '  \033[1;33m— %s %s:%s\033[0m\n\n' "$(kitap_adi "$kod")" "$bolum" "$ayet_no"
}

# ── Argüman ayrıştırma ────────────────────────────────────────────────────────
case "$1" in

  -h|--help)
    yardim; exit 0 ;;

  -l|--liste)
    liste; exit 0 ;;

  ''|-r|--random)
    ID_SATIR=$(grep -nE "$YA_PATTERN" "$DATA_FILE" | shuf -n 1)
    if [[ -z "$ID_SATIR" ]]; then
      printf '\033[1;31mHata: Veri okunamadı.\033[0m\n' >&2; exit 1
    fi
    printf '\n'
    ayeti_goster "$ID_SATIR"
    ;;

  *)
    KOD=$(kitap_kodu "$1")
    if [[ -z "$KOD" ]]; then
      printf '\033[1;31mHata: Tanınmayan kitap: "%s"\033[0m\n' "$1" >&2
      printf 'Kitap listesi için: incil -l\n' >&2; exit 1
    fi
    AD=$(kitap_adi "$KOD")

    if [[ -z "$2" ]]; then
      printf '\033[1;33mİpucu:\033[0m Bölüm belirtin → incil %s 1\n' "$1" >&2
      exit 1
    fi

    if printf '%s' "$2" | grep -q ':'; then
      # ── Tek ayet ────────────────────────────────────────────────────────────
      BOLUM=$(printf '%s' "$2" | cut -d: -f1)
      AYET=$( printf '%s' "$2" | cut -d: -f2)
      ID_SATIR=$(grep -nF "b.${KOD}.${BOLUM}.${AYET}" "$DATA_FILE")

      if [[ -z "$ID_SATIR" ]]; then
        printf '\033[1;31mHata: %s %s:%s bulunamadı.\033[0m\n' "$AD" "$BOLUM" "$AYET" >&2
        exit 1
      fi
      printf '\n'
      ayeti_goster "$ID_SATIR"

    else
      # ── Tüm bölüm ───────────────────────────────────────────────────────────
      BOLUM="$2"
      SATIRLAR=$(grep -nF "b.${KOD}.${BOLUM}." "$DATA_FILE")

      if [[ -z "$SATIRLAR" ]]; then
        printf '\033[1;31mHata: %s %s. bölüm bulunamadı.\033[0m\n' "$AD" "$BOLUM" >&2
        exit 1
      fi

      printf '\n'
      printf '  \033[1;37m%s — %s. Bölüm\033[0m\n' "$AD" "$BOLUM"
      printf '  \033[1;30m──────────────────────────────────────────────────\033[0m\n\n'

      while IFS= read -r satir; do
        ayeti_goster "$satir"
      done <<< "$SATIRLAR"
    fi
    ;;
esac
