VERI_URL="https://raw.githubusercontent.com/karimon1/incil-cli/main/data/$VERI_ADI"
VERI_DIZIN="${XDG_DATA_HOME:-$HOME/.local/share}/incil"

# ── Veri dosyasını bul (yoksa bir kez indir) ──────────────────────────────────
veri_bul() {
  local betik_dizin aday
  betik_dizin="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  for aday in "$INCIL_VERI" "$betik_dizin/data/$VERI_ADI" \
              "$VERI_DIZIN/$VERI_ADI" "/usr/share/incil/$VERI_ADI"; do
    [[ -n "$aday" && -s "$aday" ]] && { VERI="$aday"; return; }
  done

  printf '\033[1;33mKutsal Kitap verisi indiriliyor (bir kez)...\033[0m\n' >&2
  mkdir -p "$VERI_DIZIN"
  VERI="$VERI_DIZIN/$VERI_ADI"
  if command -v curl &>/dev/null; then
    curl -fsSL "$VERI_URL" -o "$VERI.tmp"
  elif command -v wget &>/dev/null; then
    wget -qO "$VERI.tmp" "$VERI_URL"
  else
    printf '\033[1;31mHata: curl veya wget bulunamadı.\033[0m\n' >&2; exit 1
  fi
  if [[ ! -s "$VERI.tmp" ]]; then
    printf '\033[1;31mHata: Veri indirilemedi.\033[0m\n' >&2
    rm -f "$VERI.tmp"; exit 1
  fi
  mv "$VERI.tmp" "$VERI"
  printf '\033[1;32mVeri kaydedildi: %s\033[0m\n' "$VERI" >&2
}

