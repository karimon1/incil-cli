      ref_coz(r, refler[r])
    }
    if (HATA) exit 1
  }
}

MOD == "rastgele" { if (rand() * NR < 1) { BUL[1] = 0; sakla(1) } ; next }

{
  anah = $4 * 1000 + $5
  for (r = 1; r <= REF_SAY; r++) {
    if (r in ARA) {
      if ((!ARA_B[r] || ARA_B[r] == $3) && katla($6) ~ ARA[r]) sakla(r)
      continue
    }
    for (i = 1; i <= AR_SAY[r]; i++)
      if (AR_B[r, i] == $3 && anah >= AR_ALT[r, i] && anah <= AR_UST[r, i]) { sakla(r); break }
  }
}

END {
  if (MOD == "liste" || HATA) exit HATA
  ilk = 1
  for (r = 1; r <= REF_SAY; r++) {
    if (!BUL[r]) { hata(MOD == "rastgele" ? "Veri okunamadı." : "Bulunamadı: " REF[r]); continue }

    if (r in ARA) {
      for (n = 1; n <= BUL[r]; n++) {
        yer = AD[S_B[r, n]] " " S_C[r, n] ":" S_V[r, n]
        if (!GUZEL) { print yer "\t" S_T[r, n]; continue }
        print "  " boya("1;33", yer)
        sar(S_T[r, n], GEN - 4, "    ", "    ")
      }
      if (GUZEL) printf "\n  %s\n", boya("1;30", BUL[r] " sonuç: \"" substr(REF[r], index(REF[r], "/") + 1) "\"")
      continue
    }

    if (!GUZEL) {
      for (n = 1; n <= BUL[r]; n++) print AD[S_B[r, n]] " " S_C[r, n] ":" S_V[r, n] "\t" S_T[r, n]
      continue
    }

    if (BUL[r] == 1) {                       # tek ayet: alıntı biçimi
      if (!ilk) print ""
      sar("\"" S_T[r, 1] "\"", GEN - 4, "  " (RENK ? "\033[0;36m" : ""), "  ")
      if (RENK) printf "\033[0m"
      print "  " boya("1;33", "— " AD[S_B[r, 1]] " " S_C[r, 1] ":" S_V[r, 1])
      ilk = 0
      continue
    }

    onceki = ""
    for (n = 1; n <= BUL[r]; n++) {
      baslik = AD[S_B[r, n]] " " S_C[r, n]
      if (baslik != onceki) {
        if (!ilk) print ""
        print "  " boya("1;37", baslik)
        print "  " boya("1;30", "────────────────────────────────────────")
        onceki = baslik; ilk = 0
      }
      sar(S_T[r, n], GEN - 7, "  " boya("0;32", sprintf("%3d", S_V[r, n])) "  ", "       ")
    }
  }
  exit HATA
}
AWK

# ── Çalıştır: mod, girdi ──────────────────────────────────────────────────────
calistir() {
  local guzel=0 renk=0 gen=80
  if [[ -t 1 ]]; then
    guzel=1
    [[ -z "$NO_COLOR" ]] && renk=1
    gen=$(tput cols 2>/dev/null || echo 80)
    (( gen > 90 )) && gen=90
  fi
  LC_ALL=C awk -v MOD="$1" -v GIRDI="$2" -v GUZEL="$guzel" -v RENK="$renk" \
    -v GEN="$gen" -v TOHUM="$RANDOM$RANDOM" "$AWK_PROG" "$VERI"
}

# Uçbirimde uzun çıktıyı sayfalayıcıya ver
goster() {
  if [[ -t 1 && -z "$SAYFASIZ" ]] && command -v "${INCIL_PAGER%% *}" &>/dev/null; then
    calistir "$@" | $INCIL_PAGER
    return "${PIPESTATUS[0]}"
  fi
  calistir "$@"
}

