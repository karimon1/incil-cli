etkilesimli() {
  printf '\n  incil %s — referans ya da /arama yazın; ?: yardım, r: rastgele, l: liste, q: çıkış\n\n' "$SURUM"
  local satir
  while IFS= read -e -r -p 'incil> ' satir; do
    satir="${satir#"${satir%%[![:space:]]*}"}"
    [[ -n "$satir" ]] && history -s -- "$satir"
    case "$satir" in
      '')          continue ;;
      q|Q|çık|cik|exit) break ;;
      '?'|h|yardım) yardim ;;
      l|liste)     goster liste "" ;;
      r|rastgele)  calistir rastgele "" ;;
      *)           goster ayet "$satir" ;;
    esac
  done
  printf '\n'
}

# ── Argümanlar ────────────────────────────────────────────────────────────────
INCIL_PAGER="${INCIL_PAGER:-less -RF}"
SAYFASIZ=""
MOD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|--yardim)        yardim; exit 0 ;;
    -n|--no-pager|--sayfasiz)  SAYFASIZ=1; shift ;;
    -l|--liste)                MOD=liste; shift ;;
    -r|--random|--rastgele)    MOD=rastgele; shift ;;
    -i|--etkilesimli)          MOD=etkilesimli; shift ;;
    -v|-V|--version|--surum)   MOD=surum; shift ;;
    --)                        shift; break ;;
    -?*)  printf '\033[1;31mHata: Bilinmeyen seçenek: %s\033[0m  (yardım: incil -h)\n' "$1" >&2; exit 1 ;;
    *)    break ;;
  esac
done

case "$MOD" in
  liste) goster liste ""; exit ;;
esac

veri_bul

case "$MOD" in
  surum)        surum ;;
  etkilesimli)  etkilesimli ;;
  rastgele)     calistir rastgele "" ;;
  *)
    if [[ $# -eq 0 ]]; then
      calistir rastgele ""
    else
      goster ayet "$*"
    fi
    ;;
esac
